{
  "files.encoding": "utf8",
  "C_Cpp.default.cStandard": "c17",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "${workspaceFolder}/.local/mingw/bin/gcc.exe",
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "cmake.cmakePath": "${workspaceFolder}/.local/cmake/bin/cmake.exe",
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "cmake.environment": {
    "PATH": "${workspaceFolder}/.local/qt/bin;${workspaceFolder}/.local/mingw/bin;${workspaceFolder}/.local/ninja;${workspaceFolder}/.local/cmake/bin;${env:PATH}",
    "QT_PLUGIN_PATH": "${workspaceFolder}/.local/qt/plugins"
  },
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}/.local/qt/bin;${workspaceFolder}/.local/mingw/bin;${workspaceFolder}/.local/ninja;${workspaceFolder}/.local/cmake/bin;${env:PATH}",
    "QT_PLUGIN_PATH": "${workspaceFolder}/.local/qt/plugins"
  },
  "C_Cpp.clang_format_style": "file",
  "editor.defaultFormatter": "ms-vscode.cpptools",
  "cmake.ctestPath": "${workspaceFolder}/.local/cmake/bin/ctest.exe"
}
