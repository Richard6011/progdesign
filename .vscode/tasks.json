{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "迷宫小球 EasyX：构建到桌面",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/BuildMaze.ps1"
      ],
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "音符碰撞 C：构建",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Development.ps1",
        "-Action",
        "Build"
      ],
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "音符碰撞 C：测试",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Development.ps1",
        "-Action",
        "Test"
      ],
      "problemMatcher": "$gcc",
      "group": "test"
    },
    {
      "label": "音符碰撞 C：运行",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Development.ps1",
        "-Action",
        "Run"
      ],
      "problemMatcher": "$gcc"
    },
    {
      "label": "音符碰撞 C：打包",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/Development.ps1",
        "-Action",
        "Package",
        "-Configuration",
        "Release"
      ],
      "problemMatcher": "$gcc"
    }
  ]
}
